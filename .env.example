DOMAIN=findcareghana.com
POSTGRES_DB=medifinder
POSTGRES_USER=medifinder
POSTGRES_PASSWORD=replace_with_a_unique_strong_password
MEDIFINDER_JWT_SECRET=replace_with_a_different_random_secret
MEDIFINDER_RATE_LIMIT=120
MEDIFINDER_DATA_VERIFIED=false
# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ. Leave empty to turn
# analytics and the cookie banner off.
MEDIFINDER_GA_MEASUREMENT_ID=
# Only for Search Console's "HTML file" verification, e.g. google1234abcd.html.
# Leave empty if you verified the domain with a DNS record.
MEDIFINDER_GOOGLE_VERIFICATION_FILE=
