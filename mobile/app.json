{
  "expo": {
    "name": "FindCare Ghana",
    "slug": "findcare-ghana",
    "scheme": "findcareghana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.findcareghana.app"
    },
    "android": {
      "package": "com.findcareghana.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0B3B36"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FindCare Ghana uses your location to find the nearest hospitals, clinics, pharmacies and ambulances."
        }
      ]
    ],
    "extra": {
      "apiOrigin": "https://findcareghana.com"
    }
  }
}
